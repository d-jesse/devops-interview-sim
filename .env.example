# Required — the app fails to start without these three set.
#
# OLLAMA_BASE_URL: point this at wherever Ollama is reachable from this
# server. If it's on a different machine, a Tailscale address (not the
# plain LAN IP) keeps this working regardless of which network either
# side is on — find it with `tailscale status` (the 100.x IP or the
# <hostname>.<tailnet>.ts.net MagicDNS name both work).
OLLAMA_BASE_URL=http://100.x.x.x:11434
GRADING_MODEL=qwen3.6:35b

# Single fixed admin login (master cheatsheet access). Set a real,
# unique password here — there is no code-level default to fall back
# to, by design, so a misconfigured deployment fails loudly instead of
# silently serving a well-known admin password.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=

# Google sign-in is disabled until both are set. Create credentials in
# Google Cloud Console (OAuth client, type "Web application") and set the
# authorized redirect URI to match GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8010/api/auth/google/callback
