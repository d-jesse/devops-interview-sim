# Tailscale address for the Mac Studio, not the plain LAN IP — this keeps
# grading working wherever this server runs, not just on the home network.
# Find it with `tailscale status` (either the 100.x Tailscale IP or the
# <hostname>.<tailnet>.ts.net MagicDNS name both work).
OLLAMA_BASE_URL=http://100.x.x.x:11434
GRADING_MODEL=qwen3.6:35b

# Single fixed admin login (master cheatsheet access) — change these.
ADMIN_EMAIL=admin@admin
ADMIN_PASSWORD=changeme123

# Google sign-in is disabled until both are set. Create credentials in
# Google Cloud Console (OAuth client, type "Web application") and set the
# authorized redirect URI to match GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8010/api/auth/google/callback
